# ─── Games & Comics Shop · Backend (Medusa v2) ───────────────────────────────
# Copia questo file in `.env` e personalizza i valori.

# Database PostgreSQL (vedi docker-compose.yml nella root del progetto)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gamescomics
DB_NAME=gamescomics

# Redis (usato solo in produzione: eventi, workflow, cache)
REDIS_URL=redis://localhost:6379

# CORS: origini autorizzate a chiamare le API
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# Segreti: in produzione genera stringhe casuali lunghe (es. `openssl rand -hex 32`)
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# URL pubblico del backend (usato dall'admin e per le immagini locali)
MEDUSA_BACKEND_URL=http://localhost:9000

# Stripe — https://dashboard.stripe.com/test/apikeys
# Lascia vuoto per usare solo il pagamento "manuale" di test.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

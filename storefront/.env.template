# ─── Games & Comics Shop · Storefront (Next.js) ──────────────────────────────
# Copia questo file in `.env.local`.

# URL del backend Medusa
MEDUSA_BACKEND_URL=http://localhost:9000

# Chiave pubblica: la stampa `npm run seed` nel backend
# (oppure Admin → Settings → Publishable API Keys)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...

# URL pubblico dello storefront
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Paese predefinito (codice ISO-2 minuscolo) quando non è determinabile
NEXT_PUBLIC_DEFAULT_REGION=it

# Chiave pubblicabile Stripe (pk_test_...) — https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_KEY=

# Segreto per la revalidation on-demand della cache di Next.js
REVALIDATE_SECRET=supersecret
